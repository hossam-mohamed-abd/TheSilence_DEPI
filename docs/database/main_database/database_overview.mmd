    classDef service fill:#dcfce7,stroke:#15803d,stroke-width:2px,color:#0f172a;
    classDef database fill:#fef3c7,stroke:#d97706,stroke-width:3px,color:#0f172a;
    classDef domain fill:#f8fafc,stroke:#475569,stroke-width:1.5px,color:#0f172a;

    class users actor;
