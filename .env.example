# Shared
NODE_ENV=development

# Backend
PORT=3000
DATABASE_URL=postgresql://user:password@host:5432/medisearch
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:4200

# Data warehouse / ETL
OLTP_DATABASE_URL=postgresql://user:password@host:5432/medisearch
DW_DATABASE_URL=postgresql://user:password@host:5432/medisearch_warehouse
SEARCH_LOG_MODE=incremental

# Storage providers
BACKBLAZE_KEY_ID=replace-me
BACKBLAZE_APPLICATION_KEY=replace-me
BACKBLAZE_BUCKET=medisearch-raw
SUPABASE_URL=https://example.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
